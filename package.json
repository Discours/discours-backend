    "graphql": "^16.8.0",
    "solid-js": "^1.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "^2.11.0",
    "terser": "^5.39.0"
  }
}
